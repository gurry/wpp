;===================================================================
; UMDF Driver
; Copyright (c) Microsoft Corporation
;===================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Sample
ClassGuid   = {78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider    = %ProviderString%
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
umdf_driver.dll = 1,,

; ================= Class section =====================

[ClassInstall32]
Addreg=SampleClassReg

[SampleClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-5

; ================= Install section =================

[Manufacturer]
%StdMfg%=Standard,NT$ARCH$.10.0...17134,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...17134]
%DeviceDesc%=UMDFDriverDevice_W10, root\UMDF_DRIVER_HW_ID

[Standard.NT$ARCH$.10.0...22000]
%DeviceDesc%=UMDFDriverDevice_W11, root\UMDF_DRIVER_HW_ID

[UMDFDriverDevice_W10.NT]
CopyFiles=Drivers_Dir

[UMDFDriverDevice_W11.NT]
CopyFiles=Drivers_Dir
Include=WUDFRD.inf
Needs=WUDFRD.NT

[Drivers_Dir]
umdf_driver.dll

[UMDFDriverDevice_W11.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW

; ================= Service installation =================
[UMDFDriverDevice_W10.NT.Services]
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\WUDFRd.sys

[UMDFDriverDevice_W11.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

; ================= WDF specific section =================
[UMDFDriverDevice_W10.NT.Wdf]
UmdfService=umdf_driver, UMDFDriverDevice_Install
UmdfServiceOrder=umdf_driver

[UMDFDriverDevice_W11.NT.Wdf]
UmdfService=umdf_driver, UMDFDriverDevice_Install
UmdfServiceOrder=umdf_driver

[UMDFDriverDevice_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary = %13%\umdf_driver.dll

; ================= Strings =================
[Strings]
ProviderString         = "TODO-Set-Provider"
StdMfg                 = "(Standard system devices)"
DiskId1                = "UMDF Driver Installation Disk #1"
DeviceDesc             = "UMDF Driver Device"
ServiceDesc            = "UMDF Driver Service"
ClassName              = "Sample Device"
